// =====================================================================
//  Millennium 5 (RNN) for JustMC — port of kireiko.dev.millennium.ml (MX Project)
//  ml_base.jc — constants, math helpers, throttling, logging, meta-data
// ---------------------------------------------------------------------
//  Storage conventions
//    s`ml.*`   — SAVE variables: the model itself (weights + config). Survive restarts.
//    g`mlg.*`  — GAME variables: runtime caches (AdamW moments, transposed weights, index lists).
//    locals    — every function uses its own name prefix, because JustMC functions share
//                the local variables of the caller (JMCC passes arguments as locals).
//  Index base of JustMC lists is 0 (same as Java).
// =====================================================================

// ---------- math constants (double literals identical to Java) ----------
inline var ML_INV_E = 0.36787944117144233;   // Math.exp(-1)
inline var ML_E = 2.718281828459045;         // Math.E
inline var ML_E2 = 7.38905609893065;         // Math.exp(2)
inline var ML_LN_EPS = 0.00001;              // LayerNorm.EPS = 1e-5
inline var ML_B1 = 0.9;                      // AdamW.B1
inline var ML_B2 = 0.999;                    // AdamW.B2
inline var ML_1MB1 = 0.09999999999999998;    // 1.0 - B1 (as evaluated by Java)
inline var ML_1MB2 = 0.0010000000000000009;  // 1.0 - B2 (as evaluated by Java)
inline var ML_ADAM_EPS = 0.00000001;         // AdamW.EPS = 1e-8
inline var ML_P_MIN = 0.000000000000001;     // 1e-15 (loss clamp)
inline var ML_P_MAX = 0.999999999999999;     // 1.0 - 1e-15
inline var ML_TIE = 0.000000000001;          // 1e-12 (checkpoint comparisons)
inline var ML_TIE9 = 0.000000001;            // 1e-9  (final-fit comparisons)
inline var ML_ATT_EPS = 0.0000000001;        // 1e-10 (attention softmax)
inline var ML_CHECKPOINT_THRESHOLD = 0.6;    // CHECKPOINT_DECISION_THRESHOLD
inline var ML_MIN_RECALL = 0.75;             // CHECKPOINT_MIN_RECALL
inline var ML_CHUNK = 150;                   // trainOneEpoch chunk size
inline var ML_FORMAT_VERSION = 6;            // RNNModelML.VERSION
inline var ML_CHUNK_WORK = 300;              // estimated actions of a piece of work between two ml_yield calls
inline var ML_WORK = 800;                    // default s`ml.work`: the most actions in one tick
inline var ML_WORK_MIN = 150;                // the pace never falls below it
inline var ML_WORK_START = 300;              // the pace a world starts with
inline var ML_CPU_AIM = 60;                  // default s`ml.cpu_aim`: CPU usage (percent) the pace is held at

// ---------- elementary functions (one place = one implementation) ----------
// sigmoid with the LSTM gate clamp (+-50): 1 / (1 + exp(-x))
// (pow and mathematical_expectation keep the full precision; add / divide would round to 9 decimals)
inline function mli_sigm(x) -> number {
  var _sg = variable::clamp(x, -50, 50);
  _sg = variable::pow(ML_INV_E, _sg);
  _sg = variable::mathematical_expectation([1, _sg], [1, 1]);
  return variable::pow(_sg, -1);
}

// MathOps.sigmoid (clamp +-500) — used by the BinaryHead
inline function mli_sigm500(x) -> number {
  var _sh = variable::clamp(x, -500, 500);
  _sh = variable::pow(ML_INV_E, _sh);
  _sh = variable::mathematical_expectation([1, _sh], [1, 1]);
  return variable::pow(_sh, -1);
}

// tanh(x) = 1 - 2 / (e^(2x) + 1); |x| > 30 gives exactly +-1.0 in double, so the clamp is lossless
inline function mli_tanh(x) -> number {
  var _th = variable::clamp(x, -30, 30);
  _th = variable::pow(ML_E2, _th);
  _th = variable::mathematical_expectation([_th, 1], [1, 1]);
  _th = variable::pow(_th, -1);
  return variable::mathematical_expectation([1, _th], [1, -2]);
}

// dot product of two equal-length lists: sum(a[i] * b[i]) — the workhorse of the port
inline function mli_dot(a, b) -> number {
  return variable::mathematical_expectation(a, b);
}

// ---------- exact arithmetic ----------
// JustMC rounds the result of add / subtract / multiply / divide to 9 decimal places, while
// mathematical_expectation and pow keep the full double precision. Gradients and optimizer moments
// are far below 1e-9, so the backward pass and AdamW use these forms (one action each, like the
// rounded ones).
inline function mli_mul(a, b) -> number {
  return variable::mathematical_expectation([a], [b]);
}
inline function mli_add2(a, b) -> number {
  return variable::mathematical_expectation([a, b], [1, 1]);
}
inline function mli_sub2(a, b) -> number {
  return variable::mathematical_expectation([a, b], [1, -1]);
}
inline function mli_one_minus(a) -> number {
  return variable::mathematical_expectation([1, a], [1, -1]);
}
inline function mli_inv(a) -> number {
  return variable::pow(a, -1);
}

// [x | rest]: the element is appended to a new list (an inline array [x] with a variable gave a list
// that mathematical_expectation could not read in JustMC)
inline function mli_cons(x, rest) -> array {
  var _cs = [];
  _cs.append_value(x);
  return variable::append_list(_cs, rest);
}

// list slice [start, endExclusive) — JustMC trim_list end index is calibrated at boot
inline function mli_slice(lst, start, end_excl) -> array {
  var _sl_e = variable::subtract([end_excl, g`mlg.trim_off`]);
  return variable::trim_list(lst, start, _sl_e);
}

// ---------- throttling: an even, small load in every tick ----------
// JustMC stops the code of a world for a line that runs too long without a wait (line_lifetime), for a CPU
// usage that stays too high (high_cpu) and for a load that comes in bursts (high_cpu_boost). So heavy work
// is cut into pieces of a few hundred actions, and ml_yield(cost) is called after each piece with its
// estimated cost in actions. When g`mlg.pace` actions are done the line waits: one tick, or more if the
// piece was bigger than the pace. The pace follows the CPU usage of the world: it grows up to s`ml.work`
// actions per tick while the usage is under s`ml.cpu_aim` percent and shrinks when it is above.
function ml_yield(yl_cost: number) {
  g`mlg.yield_acc` = variable::add([g`mlg.yield_acc`, yl_cost]);
  if (g`mlg.yield_acc`.greater_or_equals(g`mlg.pace`)) {
    ml_pause();
  }
}

function ml_pause() {
  yl_t = variable::clamp(variable::divide([g`mlg.yield_acc`, g`mlg.pace`], "FLOOR"), 1, 8);
  g`mlg.yield_acc` = 0;
  yl_i = 0;
  repeat::while(yl_i.less(yl_t)) {
    code::wait(1, "TICKS");
    yl_i = variable::add([yl_i, 1]);
  }
  yl_cpu = value::cpu_usage;
  if (yl_cpu.greater(s`ml.cpu_aim`)) {
    ml_pause_hot();
  } else {
    yl_low = variable::subtract([s`ml.cpu_aim`, 10]);
    if (yl_cpu.less(yl_low)) {
      g`mlg.pace` = variable::min([s`ml.work`, variable::add([g`mlg.pace`, 20])]);
    }
  }
}

// above the aim: slower by 2 % for every percent of the excess; far above it no work at all until it is back
function ml_pause_hot() {
  yl_over = variable::subtract([yl_cpu, s`ml.cpu_aim`]);
  yl_k = variable::clamp(variable::subtract([1, variable::multiply([yl_over, 0.02])]), 0.6, 1);
  g`mlg.pace` = variable::max([ML_WORK_MIN, variable::round(variable::multiply([g`mlg.pace`, yl_k]), 0, "FLOOR")]);
  yl_top = variable::add([s`ml.cpu_aim`, 10]);
  yl_n = 0;
  yl_go = 1;
  repeat::while(yl_go.equals(1)) {
    yl_go = 0;
    if (yl_cpu.greater(yl_top)) {
      if (yl_n.less(200)) {
        code::wait(1, "TICKS");
        yl_n = variable::add([yl_n, 1]);
        yl_cpu = value::cpu_usage;
        yl_go = 1;
      }
    }
  }
}

// mc_list split into lists of mc_per items -> mc_out (loops over them call ml_yield after every chunk)
function ml_chunks() {
  mc_out = [];
  mc_cur = [];
  repeat::for_each_in_list(mc_list) { mc_k, mc_v ->
    mc_cur.append_value(mc_v);
    if (variable::get_list_length(mc_cur).greater_or_equals(mc_per)) {
      mc_out.append_value([mc_cur]);
      mc_cur = [];
    }
  }
  if (not mc_cur.list_is_empty()) {
    mc_out.append_value([mc_cur]);
  }
}

// ---------- logging (Logger.info / warn / error) ----------
// Messages go to every online player whose UUID is in g`mlg.listeners` (admins with alerts on).
function ml_broadcast(sy_msg: text) {
  if (not g`mlg.listeners`.exists()) {
    g`mlg.listeners` = [];
  }
  if (not g`mlg.listeners`.list_is_empty()) {
    select::player_by_name(g`mlg.listeners`);
    player::message<current>(sy_msg);
    select::reset();
  }
}
function ml_log(lg_msg: text) {
  ml_broadcast("&9[MILLENNIUM] &7[Info] &f${lg_msg}");
}
function ml_warn(lw_msg: text) {
  ml_broadcast("&9[MILLENNIUM] &6[Warn] &f${lw_msg}");
}

// number -> short text with 4 decimals (String.format("%.4f") equivalent for the logs)
inline function mli_f4(x) -> number {
  return variable::round(x, 4, "ROUND");
}
inline function mli_f2(x) -> number {
  return variable::round(x, 2, "ROUND");
}

// ---------- diagnostics (used by ~ml selftest) ----------
// type of tn_v as text -> tn_t
function ml_type_name() {
  if (tn_v.is_type("NUMBER")) {
    tn_t = "number";
  } elif (tn_v.is_type("TEXT")) {
    tn_t = "text";
  } elif (tn_v.is_type("ARRAY")) {
    tn_t = "list";
  } elif (tn_v.is_type("MAP")) {
    tn_t = "map";
  } else {
    tn_t = "other";
  }
}

// trace line about the value tl_v called tl_name: a list is scanned for elements that are not numbers
// (g`mlg.trace` is 1 while ~ml selftest runs the model; the lines go to the log listeners)
function ml_trace_list() {
  if (g`mlg.trace`.greater(0)) {
    ml_trace_list_print();
  }
}

function ml_trace_list_print() {
  tn_v = tl_v;
  ml_type_name();
  tl_t = tn_t;
  if (tl_v.is_type("ARRAY")) {
    tl_n = variable::get_list_length(tl_v);
    tl_bad = -1;
    tl_bt = "";
    repeat::for_each_in_list(tl_v) { tl_k, tl_x ->
      if (not tl_x.is_type("NUMBER")) {
        if (tl_bad.equals(-1)) {
          tl_bad = tl_k;
          tn_v = tl_x;
          ml_type_name();
          tl_bt = tn_t;
        }
      }
    }
    if (tl_bad.equals(-1)) {
      ml_trace_values();
      ml_broadcast("&7[trace] &f${tl_name}: list of ${tl_n} numbers ${tl_vals}");
    } else {
      ml_broadcast("&7[trace] &c${tl_name}: list of ${tl_n}, element ${tl_bad} is ${tl_bt}");
    }
  } else {
    ml_broadcast("&7[trace] &c${tl_name}: ${tl_t}");
  }
}

// values of the traced list tl_v as text -> tl_vals: every element (4 decimals) when there are at most
// 16, otherwise the first three (6 decimals) and the sum
function ml_trace_values() {
  tl_r = [];
  if (tl_n.less_or_equals(16)) {
    repeat::for_each_in_list(tl_v) { tl_k, tl_x ->
      tl_r.append_value(variable::round(tl_x, 4, "ROUND"));
    }
    tl_vals = "= ${tl_r}";
  } else {
    tl_r.append_value(variable::round(variable::get_list_value(tl_v, 0), 6, "ROUND"));
    tl_r.append_value(variable::round(variable::get_list_value(tl_v, 1), 6, "ROUND"));
    tl_r.append_value(variable::round(variable::get_list_value(tl_v, 2), 6, "ROUND"));
    tl_vals = "first ${tl_r}, sum ${variable::round(variable::add(tl_v), 6, "ROUND")}";
  }
}

// ---------- index lists & calibration (rebuilt from the saved config) ----------
// mlg.idxIn   = [0 .. in-1]
// mlg.idxH    = [0 .. H-1]
// mlg.idxOut  = [0 .. out-1]      (out = 2H if bidirectional else H)
// mlg.dirs    = [0] or [0, 1]
// mlg.gates   = ["f", "i", "c", "o"]
function ml_rebuild_runtime() {
  if (not s`ml.work`.exists()) {
    s`ml.work` = ML_WORK;
  }
  if (not s`ml.cpu_aim`.exists()) {
    s`ml.cpu_aim` = ML_CPU_AIM;
  }
  if (not g`mlg.yield_acc`.exists()) {
    g`mlg.yield_acc` = 0;
  }
  if (not g`mlg.pace`.exists()) {
    g`mlg.pace` = variable::min([ML_WORK_START, s`ml.work`]);
  }
  ml_calibrate_trim();
  ml_build_index_lists();
  // a wide model has thousands of names and indices: pauses between the parts
  ml_yield(variable::multiply([s`ml.hid`, 3]));
  ml_build_parameter_names();
  ml_build_zero_vectors();
  ml_yield(variable::multiply([variable::add([s`ml.in`, s`ml.hid`, g`mlg.out`]), 2]));
  g`mlg.big` = variable::pow(10, 308);
  g`mlg.meta_ok` = 1;
}

// is the "end" index of trim_list inclusive? -> g`mlg.trim_off`
function ml_calibrate_trim() {
  mb_t = variable::trim_list([10, 11, 12, 13], 1, 2);
  mb_tl = variable::get_list_length(mb_t);
  if (mb_tl.equals(2)) {
    g`mlg.trim_off` = 1;
  } else {
    g`mlg.trim_off` = 0;
  }
}

// idxIn = [0..in-1], idxH = [0..H-1], idxOut = [0..out-1], layers, directions, gate letters
function ml_build_index_lists() {
  g`mlg.gates` = ["f", "i", "c", "o"];
  mr_n = s`ml.in`;
  ml_range();
  g`mlg.idxIn` = mr_list;
  ml_yield(variable::multiply([mr_n, 3]));
  mr_n = s`ml.hid`;
  ml_range();
  g`mlg.idxH` = mr_list;
  ml_yield(variable::multiply([mr_n, 3]));
  if (s`ml.bi`.equals(1)) {
    g`mlg.out` = variable::multiply([s`ml.hid`, 2]);
    g`mlg.dirs` = [0, 1];
  } else {
    g`mlg.out` = s`ml.hid`;
    g`mlg.dirs` = [0];
  }
  mr_n = g`mlg.out`;
  ml_range();
  g`mlg.idxOut` = mr_list;
  ml_yield(variable::multiply([mr_n, 3]));
  mr_n = s`ml.layers`;
  ml_range();
  g`mlg.layers` = mr_list;
  ml_build_gate_chunks();
}

// The neurons of a layer in chunks, with ml_yield after each: g`mlg.chunksH` = lists of neuron indices.
// A chunk is about ML_CHUNK_WORK actions of the most expensive loop over the neurons (the cell update,
// ~15 actions a neuron; a gate is the activation, ~6 actions, + the dot product over [1 | x | h]).
// Estimated cost of one chunk: g`mlg.chunk_cost` of a sigmoid gate, g`mlg.chunk_cand` of the candidate gate,
// g`mlg.chunk_cell` of the cell update, g`mlg.chunk_ln` of a LayerNorm loop.
function ml_build_gate_chunks() {
  mb_row = s`ml.in`;
  if (s`ml.layers`.greater(1)) {
    mb_row = variable::max([mb_row, g`mlg.out`]);
  }
  mb_row = variable::add([mb_row, s`ml.hid`, 1]);
  mb_unit = variable::add([6.3, variable::divide([mb_row, 400])]);
  mb_most = variable::max([mb_unit, 15]);
  mc_per = variable::max([4, variable::divide([ML_CHUNK_WORK, mb_most], "FLOOR")]);
  // chunks of equal size (the estimated costs are those of a full chunk)
  mb_k = variable::round(variable::divide([s`ml.hid`, mc_per]), 0, "CEIL");
  mc_per = variable::round(variable::divide([s`ml.hid`, mb_k]), 0, "CEIL");
  mc_list = g`mlg.idxH`;
  ml_chunks();
  g`mlg.chunksH` = mc_out;
  mb_n = mc_per;
  g`mlg.chunk_cost` = variable::round(variable::multiply([mb_n, mb_unit]), 0, "CEIL");
  g`mlg.chunk_cand` = variable::add([g`mlg.chunk_cost`, variable::multiply([mb_n, 2])]);
  g`mlg.chunk_cell` = variable::multiply([mb_n, 15]);
  g`mlg.chunk_ln` = variable::multiply([mb_n, 5.5]);
}

// [0, 1, ..., mr_n - 1] -> mr_list
function ml_range() {
  mr_list = [];
  mr_i = 0;
  repeat::while(mr_i.less(mr_n)) {
    mr_list.append_value(mr_i);
    mr_i = variable::add([mr_i, 1]);
  }
}

// names of every parameter vector (used by AdamW, snapshots, import / export)
function ml_build_parameter_names() {
  g`mlg.vecnames` = ["ml.embWy", "ml.embWp", "ml.embB", "ml.attn", "ml.head"];
  g`mlg.lnnames` = [];
  g`mlg.rownames` = [];
  repeat::for_each_in_list(g`mlg.layers`) { mb_li, mb_l ->
    repeat::for_each_in_list(g`mlg.dirs`) { mb_di, mb_dir ->
      mb_d = variable::add([variable::multiply([mb_l, 2]), mb_dir]);
      g`mlg.lnnames`.append_value(["ml.L.${mb_d}.g", "ml.L.${mb_d}.b"]);
      repeat::for_each_in_list(g`mlg.chunksH`) { mb_ci, mb_chunk ->
        repeat::for_each_in_list(mb_chunk) { mb_ni, mb_n ->
          repeat::for_each_in_list(g`mlg.gates`) { mb_gi, mb_gt ->
            g`mlg.rownames`.append_value("ml.L.${mb_d}.${mb_gt}.${mb_n}");
          }
        }
        ml_yield(g`mlg.chunk_ln`);
      }
    }
  }
}

// [1], zero vectors of size in / H / out
function ml_build_zero_vectors() {
  g`mlg.one` = [1];
  g`mlg.zerosIn` = [];
  repeat::for_each_in_list(g`mlg.idxIn`) { mb_k, mb_v ->
    g`mlg.zerosIn`.append_value(0);
  }
  g`mlg.zerosH` = [];
  repeat::for_each_in_list(g`mlg.idxH`) { mb_k, mb_v ->
    g`mlg.zerosH`.append_value(0);
  }
  g`mlg.zerosOut` = [];
  g`mlg.onesOut` = [];
  repeat::for_each_in_list(g`mlg.idxOut`) { mb_k, mb_v ->
    g`mlg.zerosOut`.append_value(0);
    g`mlg.onesOut`.append_value(1);
  }
  g`mlg.onesH` = [];
  repeat::for_each_in_list(g`mlg.idxH`) { mb_k, mb_v ->
    g`mlg.onesH`.append_value(1);
  }
}

// input size of LSTM layer l: in for l = 0, out (= 2H or H) otherwise
inline function mli_layer_in(l) -> number {
  var _li = s`ml.in`;
  if (l.greater(0)) {
    _li = g`mlg.out`;
  }
  return _li;
}
