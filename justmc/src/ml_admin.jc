// =====================================================================
//  ml_admin.jc — optional admin layer of the library: chat commands, model download/upload,
//  background training, self-test.  Not tied to any particular data source.
//
//  Call from YOUR events (JustMC allows one handler per event, so the hooks are functions):
//    event<world_start>         { ml_admin_boot(); }
//    event<player_join>         { ml_admin_join(); }
//    event<player_chat>         { ml_admin_chat(); }        // handles messages starting with "~ml"
//    event<world_web_response>  { ml_admin_web_response(); }
//    event<world_web_exception> { ml_admin_web_exception(); }
//
//  Commands (world owner or players from s`ml.admins`):
//    ~ml help | info | log
//    ~ml param info | ~ml param <lr|dr|rdr|wd|gc|ls|th|bs|im|pm> <value>   (alias: ml)
//    ~ml train <epochs> | ~ml stop
//    ~ml dataset info|clear|undo
//    ~ml model reset | import <url> | export <url>
//    ~ml admin add|remove <name> | ~ml selftest
// =====================================================================
import "./millennium.jc";
import "./ml_selftest_data.jc";

// chat command prefix. Not "!" (on JustMC it sends the message to the global chat),
// not "." / "#" (intercepted by some clients).
inline var ML_CMD_PREFIX = "~ml";


function ml_admin_boot() {
  ml_boot();
  if (not s`ml.admins`.exists()) {
    s`ml.admins` = [];
  }
  g`mlg.imports` = [];
  g`mlg.import_queue` = [];
  g`mlg.import_done` = 0;
  g`mlg.import_failed` = 0;
}

// in: ad_u, ad_name -> ad_ok
function ml_is_admin() {
  ad_ok = 0;
  if (ad_u.equals(value::owner_uuid)) {
    ad_ok = 1;
  }
  if (s`ml.admins`.list_contains_value(ad_name)) {
    ad_ok = 1;
  }
}

function ml_listen_add(la_u: text) {
  if (not g`mlg.listeners`.list_contains_value(la_u)) {
    g`mlg.listeners`.append_value(la_u);
  }
}

// admins get the training log automatically
function ml_admin_join() {
  ad_u = value::uuid;
  ad_name = value::name;
  ml_is_admin();
  if (ad_ok.equals(1)) {
    ml_listen_add(ad_u);
    if (s`ml.ready`.equals(0)) {
      player::message("&9[ML] &cThe model is not loaded. &fUse &e~ml model import <url> &for &e~ml model reset");
    }
  }
}

// event<player_chat>: handles "~ml ..." (sets cm_handled = 1)
function ml_admin_chat() {
  cm_handled = 0;
  cm_msg = value::event_chat_message;
  if (cm_msg.text_starts_with(ML_CMD_PREFIX)) {
    cm_handled = 1;
    world::cancel_event();
    cm_a = variable::split_text(cm_msg, " ");
    cm_sub = variable::get_list_value(cm_a, 1, "help");
    cm_a2 = variable::get_list_value(cm_a, 2, "");
    cm_a3 = variable::get_list_value(cm_a, 3, "");
    cm_a4 = variable::get_list_value(cm_a, 4, "");
    ml_admin_command();
  }
}

// in: cm_sub, cm_a2, cm_a3, cm_a4 (texts); the event player is the sender
function ml_admin_command() {
  cm_u = value::uuid;
  ad_u = cm_u;
  ad_name = value::name;
  ml_is_admin();
  if (ad_ok.equals(0)) {
    player::message("&cNo permission.");
  } else {
    ml_admin_dispatch();
  }
}

function ml_admin_dispatch() {
  if (cm_sub.equals("info")) {
    ml_cmd_info();
  } elif (cm_sub.equals("log")) {
    ml_cmd_log_toggle();
  } elif (cm_sub.equals(["param", "ml"])) {
    ml_cmd_param();
  } elif (cm_sub.equals("train")) {
    ml_cmd_train();
  } elif (cm_sub.equals("stop")) {
    ml_cmd_stop();
  } else {
    ml_admin_dispatch_model_commands();
  }
}

// dataset / model / admin / selftest / help sub-commands
function ml_admin_dispatch_model_commands() {
  if (cm_sub.equals("dataset")) {
    ml_cmd_dataset();
  } elif (cm_sub.equals("model")) {
    ml_cmd_model();
  } elif (cm_sub.equals("admin")) {
    ml_cmd_admins();
  } elif (cm_sub.equals("selftest")) {
    ml_listen_add(cm_u);
    code::start_process("ml_selftest_process", "DONT_COPY", "CURRENT_TARGET");
  } else {
    ml_cmd_help();
  }
}

// ~ml info: model state, number of weights, dataset
function ml_cmd_info() {
  ml_count_parameters();
  ml_dataset_stats();
  player::message("&9[ML] &fMillennium RNN: ready=${s`ml.ready`}, parameters=${pc_n}, step=${s`ml.step`}, threshold=${s`ml.th`}");
  player::message("&9[ML] &fdataset=${dsc_n} samples (${dsc_pos} positive), training=${g`mlg.training`}");
}

// ~ml log: training log on / off for the sender
function ml_cmd_log_toggle() {
  if (g`mlg.listeners`.list_contains_value(cm_u)) {
    g`mlg.listeners` = variable::remove_list_value(g`mlg.listeners`, cm_u);
    player::message("&9[ML] &fLog &cdisabled");
  } else {
    g`mlg.listeners`.append_value(cm_u);
    player::message("&9[ML] &fLog &aenabled");
  }
}

// ~ml stop: stop the training after the current batch
function ml_cmd_stop() {
  if (g`mlg.training`.equals(1)) {
    g`mlg.stop` = 1;
    player::message("&eStopping after the current batch...");
  } else {
    player::message("&cNothing to stop.");
  }
}

// ~ml admin add|remove <name> (world owner only)
function ml_cmd_admins() {
  if (not cm_u.equals(value::owner_uuid)) {
    player::message("&cOnly the world owner can manage admins.");
  } elif (cm_a2.equals("add")) {
    s`ml.admins`.append_value(cm_a3);
    player::message("&a${cm_a3} is now an admin.");
  } elif (cm_a2.equals("remove")) {
    s`ml.admins` = variable::remove_list_value(s`ml.admins`, cm_a3);
    player::message("&e${cm_a3} is no longer an admin.");
  } else {
    player::message("&7Admins: &f${s`ml.admins`}");
  }
}

// ~ml help
function ml_cmd_help() {
  player::message("&9[ML] &fMillennium for JustMC — commands:");
  player::message("&e~ml info &7| &e~ml log &7| &e~ml selftest");
  player::message("&e~ml param info &7| &e~ml param <lr|dr|rdr|wd|gc|ls|th|bs|im|pm> <value>");
  player::message("&e~ml train <epochs> &7| &e~ml stop &7| &e~ml dataset info|clear|undo");
  player::message("&e~ml model reset &7| &e~ml model import <url> &7| &e~ml model export <url>");
  player::message("&e~ml model save|load|delete <name> &7| &e~ml model list");
  player::message("&e~ml admin add|remove <name>");
}

// MLCommand: <param> <value>   (MX syntax "<index> <param> <value>" is accepted too)
function ml_cmd_param() {
  if (cm_a2.equals("info")) {
    ml_count_parameters();
    player::message("&9[ML] &fready=${s`ml.ready`} in=${s`ml.in`} hid=${s`ml.hid`} layers=${s`ml.layers`} bi=${s`ml.bi`} im=${s`ml.im`} pm=${s`ml.pm`} params=${pc_n}");
    player::message("&9[ML] &flr=${s`ml.lr`} dr=${s`ml.dr`} rdr=${s`ml.rdr`} wd=${s`ml.wd`} gc=${s`ml.gc`} ls=${s`ml.ls`} th=${s`ml.th`} bs=${s`ml.bs`} step=${s`ml.step`} t=${s`ml.t`}");
  } else {
    ml_cmd_param_assign();
  }
}

function ml_cmd_param_assign() {
  mp_p = cm_a2;
  mp_v = cm_a3;
  if (not cm_a4.equals("")) {
    mp_p = cm_a3;
    mp_v = cm_a4;
  }
  mp_num = variable::convert_text_to_number(mp_v, 10);
  mp_known = 1;
  if (mp_p.equals(["im", "pm"])) {
    ml_param_set_mode();
  } else {
    ml_param_set_number();
  }
  if (mp_known.equals(1)) {
    player::message("§a[ML] ${mp_p} -> ${mp_v}");
  }
  if (mp_known.equals(0)) {
    player::message("§cUnknown param. Use: lr, dr, rdr, wd, gc, ls, th, bs, im, pm");
  }
}

// numeric hyper-parameters: lr, dr, rdr, wd, gc, ls, th, bs
function ml_param_set_number() {
  if (mp_p.equals("lr")) {
    s`ml.lr` = mp_num;
  } elif (mp_p.equals("dr")) {
    s`ml.dr` = mp_num;
  } elif (mp_p.equals("rdr")) {
    s`ml.rdr` = mp_num;
  } elif (mp_p.equals("wd")) {
    s`ml.wd` = mp_num;
  } elif (mp_p.equals("gc")) {
    s`ml.gc` = mp_num;
  } elif (mp_p.equals("ls")) {
    s`ml.ls` = mp_num;
  } elif (mp_p.equals("th")) {
    s`ml.th` = variable::clamp(mp_num, 0, 1);
  } elif (mp_p.equals("bs")) {
    s`ml.bs` = variable::max([1, mp_num]);
  } else {
    mp_known = 0;
  }
}

// im (input mode) and pm (pooling mode) given by name
function ml_param_set_mode() {
  mp_up = variable::set_text_case(mp_v, "UPPER");
  if (mp_p.equals("im")) {
    mp_i = variable::get_list_index_of_value(["RAW_SEQUENCE", "STATISTICAL_FEATURES", "HYBRID"], mp_up, "FIRST");
    if (mp_i.less(0)) {
      mp_known = 2;
      player::message("&cUse RAW_SEQUENCE, STATISTICAL_FEATURES or HYBRID");
    } else {
      s`ml.im` = mp_i;
    }
  } else {
    mp_i = variable::get_list_index_of_value(["LAST_HIDDEN", "MEAN_POOLING", "MAX_POOLING", "ATTENTION"], mp_up, "FIRST");
    if (mp_i.less(0)) {
      mp_known = 2;
      player::message("&cUse LAST_HIDDEN, MEAN_POOLING, MAX_POOLING or ATTENTION");
    } else {
      s`ml.pm` = mp_i;
    }
  }
}

// TrainCommand: <epochs>   (MX syntax "<index> <epochs>" is accepted too)
function ml_cmd_train() {
  tr_arg = cm_a2;
  if (not cm_a3.equals("")) {
    tr_arg = cm_a3;
  }
  tr_ep = variable::convert_text_to_number(tr_arg, 10);
  ml_dataset_stats();
  if (not variable::number_in_range(tr_ep, 1, 1000, "INCLUDE_ALL")) {
    player::message("§cInvalid numbers.");
  } elif (g`mlg.training`.equals(1)) {
    player::message("§cTraining is already running (~ml stop).");
  } elif (s`ml.ready`.equals(0)) {
    player::message("§cModel not found. Use ~ml model import <url> or ~ml model reset");
  } elif (dsc_n.equals(0)) {
    player::message("§cDataset is empty.");
  } else {
    ml_listen_add(cm_u);
    player::message("§eStarting training process... This will take a while and run in background.");
    player::message("§aLoaded ${dsc_n} samples (${dsc_pos} positive, ${variable::subtract([dsc_n, dsc_pos])} negative).");
    player::message("§eTraining ${tr_ep} epochs...");
    ml_train_async(tr_ep);
  }
}

function ml_cmd_dataset() {
  if (cm_a2.equals("clear")) {
    s`ml.ds` = [];
    player::message("&eDataset cleared.");
  } elif (cm_a2.equals("undo")) {
    if (not s`ml.ds`.list_is_empty()) {
      du_last = variable::subtract([variable::get_list_length(s`ml.ds`), 1]);
      variable::remove_list_value_at_index(removed_value=du_rm, variable=s`ml.ds`, list=s`ml.ds`, index=du_last);
    }
    player::message("&eLast sample removed. Total: ${variable::get_list_length(s`ml.ds`)}");
  } else {
    ml_dataset_stats();
    player::message("&aDataset: ${dsc_n} samples (${dsc_pos} positive, ${variable::subtract([dsc_n, dsc_pos])} negative).");
  }
}

function ml_cmd_model() {
  if (cm_a2.equals("reset")) {
    if (g`mlg.training`.equals(1)) {
      player::message("§cTraining is running.");
    } else {
      ml_listen_add(cm_u);
      player::message("§eCreating a fresh model (Xavier + orthogonal init), this takes a while...");
      code::start_process("ml_reset_process", "DONT_COPY", "NO_TARGET");
    }
  } elif (cm_a2.equals("import")) {
    ml_cmd_model_import();
  } elif (cm_a2.equals("export")) {
    if (cm_a3.equals("")) {
      player::message("§cUsage: ~ml model export <url>  (the JSON is sent with POST)");
    } else {
      ml_listen_add(cm_u);
      xp_url = cm_a3;
      code::start_process("ml_export_process", "COPY", "NO_TARGET");
    }
  } else {
    ml_cmd_saved_models();
  }
}

// ~ml model import <url>: a model file or a manifest with the list of its parts
function ml_cmd_model_import() {
  if (cm_a3.equals("")) {
    player::message("§cUsage: ~ml model import <url>  (JSON file or manifest, see tools/ml_convert.py)");
  } else {
    // a new import replaces an unfinished one: its pending answers are ignored
    ml_listen_add(cm_u);
    g`mlg.imports` = [];
    g`mlg.import_queue` = [];
    g`mlg.import_queue`.append_value(cm_a3);
    g`mlg.import_done` = 0;
    g`mlg.import_failed` = 0;
    player::message("§eDownloading ${cm_a3} ...");
    ml_import_download_next();
  }
}

// ~ml model save|load|delete <name>, ~ml model list
function ml_cmd_saved_models() {
  sm_name = cm_a3;
  if (cm_a2.equals("list")) {
    ml_cmd_model_list();
  } elif (not cm_a2.equals(["save", "load", "delete"])) {
    player::message("§cUsage: ~ml model reset | import <url> | export <url> | save|load|delete <name> | list");
  } elif (sm_name.equals("")) {
    player::message("§cGive the model a name: ~ml model ${cm_a2} <name>");
  } elif (g`mlg.training`.equals(1)) {
    player::message("§cTraining is running.");
  } else {
    ml_listen_add(cm_u);
    sp_action = cm_a2;
    code::start_process("ml_saved_model_process", "COPY", "NO_TARGET");
  }
}

// ~ml model list: names of the saved models
function ml_cmd_model_list() {
  if (not s`mlm.list`.exists()) {
    s`mlm.list` = [];
  }
  if (s`mlm.list`.list_is_empty()) {
    player::message("&9[ML] &fNo saved models. Save the current one: &e~ml model save <name>");
  } else {
    player::message("&9[ML] &fSaved models (${variable::get_list_length(s`mlm.list`)}): &e${variable::join_text(s`mlm.list`, ", ")}");
  }
}

process ml_saved_model_process() {
  if (sp_action.equals("save")) {
    ml_model_save();
    ml_count_parameters();
    ml_broadcast("§aModel saved as '${sm_name}' (${pc_n} weights).");
  } elif (sp_action.equals("load")) {
    ml_model_load();
    if (sm_ok.equals(1)) {
      ml_count_parameters();
      ml_broadcast("§aModel '${sm_name}' loaded (${pc_n} weights, threshold ${s`ml.th`}).");
    } else {
      ml_broadcast("§cNo saved model named '${sm_name}'. See ~ml model list");
    }
  } else {
    ml_model_delete();
    ml_broadcast("§eSaved model '${sm_name}' deleted.");
  }
}

process ml_reset_process() {
  ml_init_fresh();
  ml_count_parameters();
  ml_broadcast("§aFresh model created (${pc_n} weights).");
}

process ml_export_process() {
  ml_export_chunks();
  repeat::for_each_in_list(io_chunks) { xp_k, xp_body ->
    world::send_web_request(xp_url, xp_body, {}, "POST", "APPLICATION_JSON");
    code::wait(10, "TICKS");
  }
  ml_broadcast("§aModel sent to ${xp_url} as ${variable::get_list_length(io_chunks)} JSON files (merge them with tools/ml_convert.py json2dat).");
}

function ml_admin_web_response() {
  wr_url = value::url;
  if (g`mlg.imports`.list_contains_value(wr_url)) {
    g`mlg.imports` = variable::remove_list_value(g`mlg.imports`, wr_url);
    wr_code = value::url_response_code;
    if (wr_code.equals(200)) {
      ip_text = value::url_response;
      ip_url = wr_url;
      code::start_process("ml_import_process", "COPY", "NO_TARGET");
    } else {
      ml_warn("Import failed: HTTP ${wr_code} for ${wr_url}");
      g`mlg.import_failed` = variable::add([g`mlg.import_failed`, 1]);
      ml_import_download_next();
    }
  }
}

function ml_admin_web_exception() {
  we_url = value::url;
  if (g`mlg.imports`.list_contains_value(we_url)) {
    g`mlg.imports` = variable::remove_list_value(g`mlg.imports`, we_url);
    ml_warn("Import failed (web exception) for ${we_url}");
    g`mlg.import_failed` = variable::add([g`mlg.import_failed`, 1]);
    ml_import_download_next();
  }
}

// download the next file of the import queue (one at a time); report when the queue is empty
function ml_import_download_next() {
  if (g`mlg.import_queue`.list_is_empty()) {
    ml_count_parameters();
    ml_log("Model import finished: ${g`mlg.import_done`} file(s), ${g`mlg.import_failed`} failed -> ready=${s`ml.ready`}, parameters=${pc_n}");
  } else {
    dn_url = variable::get_list_value(g`mlg.import_queue`, 0);
    variable::remove_list_value_at_index(removed_value=dn_rm, variable=g`mlg.import_queue`, list=g`mlg.import_queue`, index=0);
    g`mlg.imports`.append_value(dn_url);
    world::send_web_request(dn_url, "", {}, "GET", "TEXT_PLAIN");
  }
}

// files of a manifest -> import queue (relative names are resolved against the manifest URL)
function ml_import_queue_manifest() {
  mq_dir = variable::split_text(ip_url, "/");
  mq_last = variable::subtract([variable::get_list_length(mq_dir), 1]);
  variable::remove_list_value_at_index(removed_value=mq_rm, variable=mq_dir, list=mq_dir, index=mq_last);
  mq_base = variable::join_text(mq_dir, "/");
  repeat::for_each_in_list(io_manifest) { mq_k, mq_f ->
    if (mq_f.text_starts_with("http")) {
      g`mlg.import_queue`.append_value(mq_f);
    } else {
      g`mlg.import_queue`.append_value("${mq_base}/${mq_f}");
    }
  }
  ml_log("Manifest ${ip_url}: ${variable::get_list_length(io_manifest)} file(s) to download...");
}

process ml_import_process() {
  io_text = ip_text;
  ml_import_json();
  if (io_ok.equals(2)) {
    ml_import_queue_manifest();
  } elif (io_ok.equals(1)) {
    g`mlg.import_done` = variable::add([g`mlg.import_done`, 1]);
    ip_mod = variable::remainder(g`mlg.import_done`, 10, "REMAINDER");
    if (ip_mod.equals(0)) {
      ml_log("Model import: ${g`mlg.import_done`} file(s) loaded...");
    }
  } else {
    g`mlg.import_failed` = variable::add([g`mlg.import_failed`, 1]);
    ml_warn("Bad model file ${ip_url}: ${io_msg}");
  }
  ml_import_download_next();
}

// ~ml selftest: checks of the JustMC behaviour the port relies on, probes (one process each, so a
// crash kills only that probe) and the reference inference with a stage trace
process ml_selftest_process() {
  g`mlg.trace` = 0;
  g`mlg.trace_pre` = 0;
  ml_selftest_semantics();
  ml_selftest_lists();
  ml_selftest_json();
  ml_selftest_reference_data();
  player::message("&9[selftest] &fsemantics ok: ${st_ok} &7(trim_off=${g`mlg.trim_off`})");
  st_bad = 0;
  if (s`ml.ready`.equals(1)) {
    ml_selftest_model_types();
  }
  ml_selftest_start_probes();
  if (s`ml.ready`.equals(0)) {
    player::message("&9[selftest] &7no model loaded, inference skipped");
  } elif (st_ok.equals(0)) {
    player::message("&9[selftest] &cinference skipped: send a screenshot of the lines above");
  } elif (st_bad.greater(0)) {
    player::message("&9[selftest] &cinference skipped: the model has broken vectors, import it again");
  } else {
    ml_selftest_inference();
  }
}

// the reference sequence through the model, with trace lines after every stage
function ml_selftest_inference() {
  ml_selftest_sequence();
  ck_ys = st_ys;
  ck_ps = st_ps;
  player::message("&9[selftest] &fmodel run (trace lines follow; the last one shows where it stops if it fails):");
  g`mlg.trace` = 1;
  controller::measure_time(st_ms, "MILLISECONDS") {
    ml_check_data();
  }
  g`mlg.trace` = 0;
  player::message("&9[selftest] &fRNN probability: &e${ck_prob} &7(${st_ms} ms)");
  player::message("&9[selftest] &fexpected for the original quark-e weights: &e${ML_ST_EXPECTED}");
}

// every probe runs in its own process: a missing "[probe N]" line means that probe crashed
function ml_selftest_start_probes() {
  player::message("&9[selftest] &fprobes 1-25 (a missing number = that probe crashed):");
  st_probe = 1;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 3;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 4;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 5;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 6;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 8;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 10;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  ml_selftest_start_building_probes();
  if (s`ml.ready`.equals(1)) {
    ml_selftest_start_model_probes();
  }
}

// probes 16-23 (list building), one process each
function ml_selftest_start_building_probes() {
  st_probe = 16;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 17;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 18;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 19;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 20;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 21;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 22;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 23;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 24;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 25;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
}

// probes that need a loaded model
function ml_selftest_start_model_probes() {
  st_probe = 13;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 14;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  st_probe = 15;
  code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  if (s`ml.ready`.equals(1)) {
    st_probe = 11;
    code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
    st_probe = 12;
    code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
    st_probe = 2;
    code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
    st_probe = 7;
    code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
    st_probe = 9;
    code::start_process("ml_selftest_probe_process", "COPY", "CURRENT_TARGET");
  }
}

process ml_selftest_probe_process() {
  if (st_probe.less(7)) {
    ml_probe_dispatch_lists();
  } elif (st_probe.less(13)) {
    ml_probe_dispatch_model();
  } else {
    ml_probe_dispatch_heads();
  }
}

// probes 13-15: the attention row before and after the rebuild, a LayerNorm vector; 16-23: list building
function ml_probe_dispatch_heads() {
  if (st_probe.equals(13)) {
    pb_v = variable::mathematical_expectation(g`mlg.attn_orig`, g`mlg.attn_orig`);
    player::message("&7[probe 13] &foriginal attention row . itself = ${pb_v}");
  } elif (st_probe.equals(14)) {
    pb_v = variable::mathematical_expectation(s`ml.attn`, s`ml.attn`);
    player::message("&7[probe 14] &frebuilt attention row . itself = ${pb_v} (same as probe 13)");
  } elif (st_probe.equals(15)) {
    pb_v = variable::mathematical_expectation(s`ml.L.0.g`, s`ml.L.0.g`);
    player::message("&7[probe 15] &fLayerNorm gamma of layer 0 . itself = ${pb_v}");
  } else {
    ml_probe_dispatch_building();
  }
}

// probes 16-23: ways of building a list, each used in a dot product or an addition
function ml_probe_dispatch_building() {
  pb_x = 0.5;
  pb_m = variable::parse_json('{"b":-0.5,"w":[1,2]}');
  pb_y = variable::get_map_value(pb_m, "b");
  pb_w = variable::get_map_value(pb_m, "w");
  if (st_probe.less(20)) {
    ml_probe_dispatch_building_a();
  } else {
    ml_probe_dispatch_building_b();
  }
}

// probes 16-19
function ml_probe_dispatch_building_a() {
  if (st_probe.equals(16)) {
    ml_probe_inline_variable();
  } elif (st_probe.equals(17)) {
    ml_probe_inline_map_number();
  } elif (st_probe.equals(18)) {
    ml_probe_inline_plus_list();
  } else {
    ml_probe_cons();
  }
}

// probes 20-24
function ml_probe_dispatch_building_b() {
  if (st_probe.equals(20)) {
    ml_probe_rebuild_by_index();
  } elif (st_probe.equals(21)) {
    ml_probe_loop_add();
  } elif (st_probe.equals(22)) {
    ml_probe_nested_inline();
  } elif (st_probe.equals(23)) {
    ml_probe_append_map_number();
  } elif (st_probe.equals(24)) {
    ml_probe_math_precision();
  } else {
    ml_probe_variable_arithmetic();
  }
}

// 25: arithmetic on variables (nothing can be computed in advance here): small and long results
function ml_probe_variable_arithmetic() {
  pb_l = variable::parse_json("[1,3,7,0.000001,0.0000000001,1.0000000001]");
  pb_one = variable::get_list_value(pb_l, 0);
  pb_three = variable::get_list_value(pb_l, 1);
  pb_seven = variable::get_list_value(pb_l, 2);
  pb_small = variable::get_list_value(pb_l, 3);
  pb_tiny = variable::get_list_value(pb_l, 4);
  pb_near = variable::get_list_value(pb_l, 5);
  pb_a = variable::divide([pb_one, pb_three]);
  pb_b = variable::divide([pb_one, pb_seven]);
  pb_c = variable::multiply([pb_small, pb_small]);
  pb_d = variable::add([pb_tiny, pb_tiny]);
  pb_e = variable::subtract([pb_near, pb_one]);
  pb_f = variable::pow(pb_small, 2);
  pb_g = variable::mathematical_expectation([pb_small], [pb_small]);
  pb_h = variable::multiply([pb_a, pb_three]);
  player::message("&7[probe 25] &f1/3 = ${pb_a} (0.3333333333333333); 1/7 = ${pb_b} (0.14285714285714285); 1e-6 * 1e-6 = ${pb_c} (1e-12); 1e-10 + 1e-10 = ${pb_d} (2e-10); 1.0000000001 - 1 = ${pb_e} (1e-10); pow(1e-6, 2) = ${pb_f} (1e-12); dot [1e-6].[1e-6] = ${pb_g} (1e-12); (1/3) * 3 = ${pb_h} (1)");
}

// 24: precision of the arithmetic the model relies on (every value is expected with 16-17 digits)
function ml_probe_math_precision() {
  pb_a = variable::divide([1, 3]);
  pb_b = variable::pow(0.36787944117144233, 2);
  pb_c = variable::pow(7.38905609893065, 0.5);
  pb_d = variable::log(10, 2);
  pb_e = variable::pow(2, 0.5);
  pb_f = variable::mathematical_expectation([0.1, 0.2], [3, 7]);
  player::message("&7[probe 24] &f1/3 = ${pb_a} (0.3333333333333333); e^-2 = ${pb_b} (0.1353352832366127); sqrt(e^2) = ${pb_c} (2.718281828459045); log2(10) = ${pb_d} (3.321928094887362); sqrt 2 = ${pb_e} (1.4142135623730951); 0.1*3+0.2*7 = ${pb_f} (1.7000000000000002)");
}

// 16: [variable] stored in a variable, then a dot product
function ml_probe_inline_variable() {
  pb_d = [pb_x];
  pb_v = variable::mathematical_expectation(pb_d, pb_d);
  player::message("&7[probe 16] &f[variable] stored, then dot product: ${pb_v} (0.25)");
}

// 17: [number from a JSON map] stored, then a dot product
function ml_probe_inline_map_number() {
  pb_e = [pb_y];
  pb_v = variable::mathematical_expectation(pb_e, [1]);
  player::message("&7[probe 17] &f[number from a JSON map] stored, then dot product: ${pb_v} (-0.5)");
}

// 18: append_list([number from a JSON map], JSON list), then a dot product (the old import)
function ml_probe_inline_plus_list() {
  pb_f = variable::append_list([pb_y], pb_w);
  pb_v = variable::mathematical_expectation(pb_f, pb_f);
  player::message("&7[probe 18] &f[number from a JSON map] + JSON list, then dot product: ${pb_v} (5.25)");
}

// 19: the same list built by appending (the new import)
function ml_probe_cons() {
  pb_g = mli_cons(pb_y, pb_w);
  pb_v = variable::mathematical_expectation(pb_g, pb_g);
  player::message("&7[probe 19] &fthe same list built by appending: ${pb_v} (5.25)");
}

// 20: an element of [variable] read with get_list_value, + 0, appended to a new list (the rebuild at boot)
function ml_probe_rebuild_by_index() {
  pb_d = [pb_x];
  pb_e = variable::get_list_value(pb_d, 0);
  pb_f = [];
  pb_f.append_value(variable::add([pb_e, 0]));
  pb_v = variable::mathematical_expectation(pb_f, pb_f);
  player::message("&7[probe 20] &felement of [variable] read by index, + 0, appended, then dot product: ${pb_v} (0.25)");
}

// 21: a loop over [variable] with an addition of every element
function ml_probe_loop_add() {
  pb_d = [pb_x];
  pb_s = 0;
  repeat::for_each_in_list(pb_d) { pb_k, pb_e ->
    pb_s = variable::add([pb_s, pb_e]);
  }
  player::message("&7[probe 21] &floop over [variable] with addition: ${pb_s} (0.5)");
}

// 22: [[a, b]] appended, the inner list read by index, then a dot product
function ml_probe_nested_inline() {
  pb_o = [];
  pb_o.append_value([[pb_x, pb_y]]);
  pb_i = variable::get_list_value(pb_o, 0);
  pb_v = variable::mathematical_expectation(pb_i, pb_i);
  player::message("&7[probe 22] &f[[a, b]] appended, inner list by index, then dot product: ${pb_v} (0.5)");
}

// 23: a number from a JSON map appended to a new list, then a dot product
function ml_probe_append_map_number() {
  pb_f = [];
  pb_f.append_value(pb_y);
  pb_v = variable::mathematical_expectation(pb_f, [1]);
  player::message("&7[probe 23] &fnumber from a JSON map appended, then dot product: ${pb_v} (-0.5)");
}

// probes 1-6: lists and arithmetic
function ml_probe_dispatch_lists() {
  if (st_probe.equals(1)) {
    ml_probe_dot_product();
  } elif (st_probe.equals(2)) {
    ml_probe_weight_row();
  } elif (st_probe.equals(3)) {
    ml_probe_sum_max_sort();
  } elif (st_probe.equals(4)) {
    ml_probe_nested_lists();
  } elif (st_probe.equals(5)) {
    ml_probe_dynamic_locals();
  } else {
    ml_probe_slices();
  }
}

// probes 7-12: the weights, the stages of the model, local variable limits
function ml_probe_dispatch_model() {
  if (st_probe.equals(7)) {
    ml_probe_scan_weights();
  } elif (st_probe.equals(8)) {
    ml_probe_magnitudes();
  } elif (st_probe.equals(9)) {
    ml_probe_preprocess();
  } elif (st_probe.equals(10)) {
    ml_probe_many_locals();
  } elif (st_probe.equals(11)) {
    ml_probe_pooling();
  } else {
    ml_probe_pooling_after_locals();
  }
}

// 10: 600 local variables with names built from a number
function ml_probe_many_locals() {
  pb_i = 0;
  repeat::while(pb_i.less(600)) {
    `pb.v.${pb_i}` = pb_i;
    pb_i = variable::add([pb_i, 1]);
  }
  pb_n = 0;
  pb_i = 0;
  repeat::while(pb_i.less(600)) {
    if (`pb.v.${pb_i}`.exists()) {
      pb_n = variable::add([pb_n, 1]);
    }
    pb_i = variable::add([pb_i, 1]);
  }
  player::message("&7[probe 10] &flocal variables with dynamic names: ${pb_n} of 600 exist, pb.v.599 = ${`pb.v.599`} (599)");
}

// 11: the pooling of the model on 7 rows of zeros (a fresh process with few local variables)
function ml_probe_pooling() {
  po_H = [];
  po_M = [];
  repeat::for_each_in_list([1, 2, 3, 4, 5, 6, 7]) { pb_k, pb_i ->
    po_H.append_value([g`mlg.zerosOut`]);
    po_M.append_value(1);
  }
  ml_pool_forward();
  player::message("&7[probe 11] &fpooling in a fresh process: pooled ${variable::get_list_length(po_v)} numbers (${g`mlg.out`}), first ${variable::get_list_value(po_v, 0)} (0)");
}

// 12: the same pooling after 400 other local variables were created in the process
function ml_probe_pooling_after_locals() {
  pb_i = 0;
  repeat::while(pb_i.less(400)) {
    `pb.w.${pb_i}` = pb_i;
    pb_i = variable::add([pb_i, 1]);
  }
  po_H = [];
  po_M = [];
  repeat::for_each_in_list([1, 2, 3, 4, 5, 6, 7]) { pb_k, pb_i ->
    po_H.append_value([g`mlg.zerosOut`]);
    po_M.append_value(1);
  }
  ml_pool_forward();
  player::message("&7[probe 12] &fpooling after 400 local variables: pooled ${variable::get_list_length(po_v)} numbers (${g`mlg.out`})");
}

// 1: dot product of two list variables of 100 numbers
function ml_probe_dot_product() {
  pb_a = [];
  pb_i = 0;
  repeat::while(pb_i.less(100)) {
    pb_a.append_value(pb_i);
    pb_i = variable::add([pb_i, 1]);
  }
  pb_v = variable::mathematical_expectation(pb_a, pb_a);
  player::message("&7[probe 1] &fdot product of two list variables of 100: ${pb_v} (expected 328350)");
}

// 2: a weight row from a save variable in a dot product
function ml_probe_weight_row() {
  pb_r = s`ml.L.0.f.0`;
  pb_z = variable::append_list(g`mlg.one`, g`mlg.zerosIn`);
  pb_z = variable::append_list(pb_z, g`mlg.zerosH`);
  pb_v = variable::mathematical_expectation(pb_r, pb_z);
  player::message("&7[probe 2] &frow ml.L.0.f.0 (${variable::get_list_length(pb_r)}) . [1 | zeros] (${variable::get_list_length(pb_z)}) = ${pb_v}, its bias = ${variable::get_list_value(pb_r, 0)}");
  pb_v = variable::mathematical_expectation(pb_r, pb_r);
  player::message("&7[probe 2] &frow . row = ${pb_v}");
}

// 3: sum, max and sort of a list variable
function ml_probe_sum_max_sort() {
  pb_a = [];
  pb_i = 1;
  repeat::while(pb_i.less_or_equals(100)) {
    pb_a.append_value(pb_i);
    pb_i = variable::add([pb_i, 1]);
  }
  pb_s = variable::add(pb_a);
  pb_m = variable::max(pb_a);
  pb_sorted = variable::sort_list(pb_a, "DESCENDING");
  pb_f = variable::get_list_value(pb_sorted, 0);
  player::message("&7[probe 3] &fsum of 1..100 = ${pb_s} (5050), max = ${pb_m} (100), sorted descending starts with ${pb_f} (100)");
}

// 4: list of lists, [1] + row
function ml_probe_nested_lists() {
  pb_row = [0.5, 1.5, 2.5];
  pb_X = [];
  pb_X.append_value([pb_row]);
  pb_X.append_value([pb_row]);
  pb_r1 = variable::get_list_value(pb_X, 1);
  tn_v = pb_r1;
  ml_type_name();
  pb_t1 = tn_t;
  tn_v = variable::get_list_value(pb_r1, 2);
  ml_type_name();
  pb_z = variable::append_list(g`mlg.one`, pb_r1);
  player::message("&7[probe 4] &flist of lists: ${variable::get_list_length(pb_X)} rows (2), row 1 is a ${pb_t1} (list) of ${variable::get_list_length(pb_r1)} (3), its last element is a ${tn_t} (number); [1] + row has ${variable::get_list_length(pb_z)} (4)");
}

// 5: local lists with names built from a number
function ml_probe_dynamic_locals() {
  repeat::for_each_in_list([0, 1, 2]) { pb_k, pb_i ->
    `st.col.${pb_i}` = [];
  }
  pb_rows = [];
  pb_rows.append_value([[7, 8, 9]]);
  pb_rows.append_value([[4, 5, 6]]);
  repeat::for_each_in_list(pb_rows) { pb_t, pb_h ->
    repeat::for_each_in_list(pb_h) { pb_i, pb_x ->
      `st.col.${pb_i}`.append_value(pb_x);
    }
  }
  pb_v = variable::mathematical_expectation(`st.col.0`, [1, 1]);
  pb_n = variable::get_list_length(`st.col.2`);
  pb_s = 0;
  repeat::for_each_in_list([0, 1, 2]) { pb_k, pb_i ->
    pb_s = variable::add([pb_s, variable::mathematical_expectation(`st.col.${pb_i}`, [1, 1])]);
  }
  player::message("&7[probe 5] &flocal lists with dynamic names: column 0 sum = ${pb_v} (11), column 2 length = ${pb_n} (2), sum of all read by name = ${pb_s} (39)");
}

// 6: slices of the 150-element reference lists
function ml_probe_slices() {
  ml_selftest_sequence();
  pb_a = mli_slice(st_ys, 0, 150);
  pb_b = mli_slice(st_ps, 126, 150);
  tn_v = variable::get_list_value(pb_a, 149);
  ml_type_name();
  player::message("&7[probe 6] &fslice 0..150 of the reference: ${variable::get_list_length(pb_a)} (150), last is a ${tn_t} (number); slice 126..150: ${variable::get_list_length(pb_b)} (24)");
}

// 7: every element of every weight vector must be a number
function ml_probe_scan_weights() {
  pb_names = variable::append_list(variable::append_list(g`mlg.vecnames`, g`mlg.lnnames`), g`mlg.rownames`);
  pb_bad = 0;
  pb_first = "";
  repeat::for_each_in_list(pb_names) { pb_k, pb_n ->
    pb_vec = s`${pb_n}`;
    repeat::for_each_in_list(pb_vec) { pb_i, pb_x ->
      if (not pb_x.is_type("NUMBER")) {
        ml_probe_bad_element();
      }
    }
    ml_yield(variable::get_list_length(pb_vec));
  }
  player::message("&7[probe 7] &fweight elements that are not numbers: ${pb_bad} ${pb_first}");
}

function ml_probe_bad_element() {
  pb_bad = variable::add([pb_bad, 1]);
  if (pb_first.equals("")) {
    tn_v = pb_x;
    ml_type_name();
    pb_first = "(first: ${pb_n}[${pb_i}] is a ${tn_t})";
  }
}

// 8: the first stage of the model on the reference: magnitudes sqrt(yaw^2 + pitch^2)
function ml_probe_magnitudes() {
  ml_selftest_sequence();
  pp_ys = st_ys;
  pp_ps = st_ps;
  ml_rotation_magnitudes();
  tl_name = "[probe 8] magnitudes";
  tl_v = ps_mag;
  ml_trace_list_print();
  player::message("&7[probe 8] &fmagnitudes: ${variable::get_list_length(ps_mag)} (150), first ${variable::get_list_value(ps_mag, 0)} (2.4499...)");
}

// 9: the statistical preprocessor on the reference, every window traced
function ml_probe_preprocess() {
  ml_selftest_sequence();
  pp_ys = st_ys;
  pp_ps = st_ps;
  pp_n = 150;
  g`mlg.trace_pre` = 1;
  ml_preprocess_statistical();
  g`mlg.trace_pre` = 0;
  player::message("&7[probe 9] &fpreprocess: ${variable::get_list_length(pp_X)} windows (7), mask ${pp_M}");
}

// list loop index base, slices checked by value, value of an index outside the list
function ml_selftest_lists() {
  st_first = -1;
  repeat::for_each_in_list([7, 8]) { st_i, st_x ->
    if (st_x.equals(7)) {
      st_first = st_i;
    }
  }
  if (not st_first.equals(0)) {
    st_ok = 0;
    player::message("&c[selftest] list loop index of the first element is ${st_first}, expected 0");
  }
  st_l = mli_slice([10, 11, 12, 13], 1, 3);
  st_a = variable::get_list_value(st_l, 0, -1);
  if (not st_a.equals(11)) {
    st_ok = 0;
    player::message("&c[selftest] slice 1..3 of [10, 11, 12, 13] = ${st_l}, expected [11, 12]");
  }
  st_l = mli_slice([10, 11, 12], 0, 3);
  st_a = variable::get_list_length(st_l);
  if (not st_a.equals(3)) {
    st_ok = 0;
    player::message("&c[selftest] slice 0..3 of [10, 11, 12] = ${st_l}, expected the whole list");
  }
  tn_v = variable::get_list_value([1, 2], 5);
  ml_type_name();
  player::message("&7[selftest] value outside a list: ${tn_t}");
}

// parse_json: numbers in a list, in a list inside a list, in a list inside a map
function ml_selftest_json() {
  st_j = variable::parse_json("[0.5,1e-05,-2,[0.25,3]]");
  tn_v = variable::get_list_value(st_j, 0);
  ml_type_name();
  st_t1 = tn_t;
  st_v1 = variable::get_list_value(st_j, 1);
  tn_v = st_v1;
  ml_type_name();
  st_t2 = tn_t;
  st_in = variable::get_list_value(st_j, 3);
  tn_v = st_in;
  ml_type_name();
  st_t3 = tn_t;
  tn_v = variable::get_list_value(st_in, 0);
  ml_type_name();
  st_t4 = tn_t;
  st_m = variable::parse_json('{"a":[0.75]}');
  tn_v = variable::get_list_value(variable::get_map_value(st_m, "a"), 0);
  ml_type_name();
  st_all = "${st_t1} ${st_t2} ${st_t3} ${st_t4} ${tn_t}";
  if (not st_all.equals("number number list number number")) {
    st_ok = 0;
    player::message("&c[selftest] json [0.5, 1e-05, -2, [0.25, 3]] / {a:[0.75]} gives: ${st_all} (1e-05 -> ${st_v1})");
  }
}

// the reference sequence written in the code: 150 numbers in each list
function ml_selftest_reference_data() {
  ml_selftest_sequence();
  st_a = variable::get_list_length(st_ys);
  st_b = variable::get_list_length(st_ps);
  tn_v = variable::get_list_value(st_ps, 149);
  ml_type_name();
  if (not "${st_a} ${st_b} ${tn_t}".equals("150 150 number")) {
    st_ok = 0;
    player::message("&c[selftest] reference sequence: ${st_a} / ${st_b} values, last one is ${tn_t} (expected 150 / 150, number)");
  }
}

// every weight vector must be a list of numbers -> st_bad (count), first broken name in the chat
function ml_selftest_model_types() {
  st_bad = 0;
  st_names = variable::append_list(variable::append_list(g`mlg.vecnames`, g`mlg.lnnames`), g`mlg.rownames`);
  repeat::for_each_in_list(st_names) { st_k, st_n ->
    st_vec = s`${st_n}`;
    st_good = 0;
    if (st_vec.is_type("ARRAY")) {
      st_last = variable::subtract([variable::get_list_length(st_vec), 1]);
      st_e0 = variable::get_list_value(st_vec, 0);
      st_e1 = variable::get_list_value(st_vec, st_last);
      if (st_e0.is_type("NUMBER")) {
        if (st_e1.is_type("NUMBER")) {
          st_good = 1;
        }
      }
    }
    if (st_good.equals(0)) {
      ml_selftest_report_vector();
    }
    ml_yield(12);
  }
  player::message("&9[selftest] &fweight vectors: ${variable::get_list_length(st_names)}, broken: ${st_bad}");
}

// first broken vector: its type and the type of its first element
function ml_selftest_report_vector() {
  st_bad = variable::add([st_bad, 1]);
  if (st_bad.equals(1)) {
    tn_v = st_vec;
    ml_type_name();
    st_tv = tn_t;
    tn_v = variable::get_list_value(st_vec, 0);
    ml_type_name();
    player::message("&c[selftest] broken vector ${st_n}: ${st_tv}, first element ${tn_t}");
  }
}

// checks of the JustMC behaviour the library relies on -> st_ok
function ml_selftest_semantics() {
  st_ok = 1;
  st_v = variable::get_list_value([5, 6, 7], 0);
  if (not st_v.equals(5)) {
    st_ok = 0;
    player::message("&c[selftest] list index base is not 0 (got ${st_v})");
  }
  st_v = variable::mathematical_expectation([1, 2, 3], [4, 5, 6]);
  if (not st_v.equals(32)) {
    st_ok = 0;
    player::message("&c[selftest] mathematical_expectation is not a dot product (got ${st_v}, expected 32)");
  }
  st_v = variable::mathematical_expectation([1, -2], [-3, 0.5]);
  if (not st_v.equals(-4)) {
    st_ok = 0;
    player::message("&c[selftest] mathematical_expectation rejects negative weights (got ${st_v}, expected -4)");
  }
  st_v = variable::bitwise_operation(5, 3, "XOR");
  if (not st_v.equals(6)) {
    st_ok = 0;
    player::message("&c[selftest] XOR(5,3) = ${st_v}");
  }
  st_a = variable::get_list_length([1, 2, 3, 4, 5, 6, 7]);
  st_v = variable::divide([st_a, 2], "FLOOR");
  if (not st_v.equals(3)) {
    st_ok = 0;
    player::message("&c[selftest] FLOOR(7/2) = ${st_v}");
  }
  st_v = variable::log(8, 2);
  if (not variable::number_in_range(st_v, 2.9999999, 3.0000001, "INCLUDE_ALL")) {
    st_ok = 0;
    player::message("&c[selftest] log2(8) = ${st_v}");
  }
  st_v = variable::get_list_length(mli_slice([1, 2, 3, 4], 1, 3));
  if (not st_v.equals(2)) {
    st_ok = 0;
    player::message("&c[selftest] slice length ${st_v} (trim_off=${g`mlg.trim_off`})");
  }
}
